# 复制成 .env 再填自己的值。.env 不进版本库（见 .gitignore）。
# 只要服务商支持 OpenAI 的 /v1/chat/completions，都能填在这三行里：
#   Ollama      http://127.0.0.1:11434/v1        qwen2.5:7b-instruct
#   vLLM        http://127.0.0.1:8000/v1         Qwen/Qwen2.5-7B-Instruct
#   LM Studio   http://127.0.0.1:1234/v1         qwen2.5-7b-instruct
#   中转站       https://api.openai-next.com/v1   qwen-flash
PET_LLM_BASE_URL=https://api.openai-next.com/v1
PET_LLM_MODEL=qwen-flash
PET_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PET_LLM_TIMEOUT=25
PET_LLM_MAX_TOKENS=160

# 路演日期钉死（可选）：不填就取当天
# HAMSTER_TODAY=2026-10-31
